{
  "name": "json-benchmark",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "lint": "biome check . && rumdl check .",
    "format": "biome check --write . && rumdl fmt .",
    "benchmark": "node src/suites/serialize/get-all.bench.js && node src/suites/deserialize/get-all.bench.js",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "avsc": "^5.7.9",
    "bser": "^2.1.2",
    "bson": "^7.3.4",
    "fast-json-stringify": "^7.3.5",
    "js-binary": "^1.2.0",
    "msgpackr": "^2.1.4",
    "protobufjs": "^8.8.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "lefthook": "^2.2.2",
    "rumdl": "^0.3.2"
  },
  "trustedDependencies": [
    "msgpackr-extract",
    "protobufjs"
  ]
}
